# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Test / coverage
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# In-place virtual environment (python -m venv .)
/Lib/
/Include/
/pyvenv.cfg
/Scripts/

# IDE
.vscode/
.idea/

# Environment variables
.env
.env.*
!.env.example

# Build artifacts
build/
dist/
*.egg-info/

# Logs
*.log

# Tooling caches
.mypy_cache/
.ruff_cache/
.pyre/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# TLS material (never commit private keys or machine-specific trust files)
*.key
*.pfx
*.p12
*.crt
*.cer
*.pem
!runtime/certificates/.gitkeep

# Remembered external-device files (real device files live in home dir, never in git)
.risarms-device.json
*-device.json
device.json

# Runtime state / secrets
runtime/*
!runtime/certificates/
!runtime/certificates/.gitkeep

# Tool backups
opencode.json.backup
.aider*

# Stagnant artifacts
.pytest_cache/
__pycache__/
AUDIT_REPORT.md
temp_*.txt
test_output.txt
test_results.txt

# Sensitive files
tls/
*.pem
*.key
*.crt

# PyInstaller and native installer output (built by CI, never committed)
*.spec
*.dmg
*.msi
*.AppImage
*.deb
*.rpm
*.pkg
SHA256SUMS
sbom.cdx.json
release/

# Local databases (never commit)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
# Signing keys, release credentials and local secret stores
.secrets/
secrets/
*.ed25519
*.priv
private-key*
release-keys/
